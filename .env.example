# Copy thành .env, điền thông tin Supabase. Không đưa service role key vào public/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# prisma: imageUrl, chefId, _DishToIngredient (giống db.js bản SSR).
# snake: image_url, chef_id, dish_ingredients (file SQL cũ).
DB_SCHEMA_STYLE=prisma
MANAGER_EMAIL=manager@restaurant.com
APP_URL=http://localhost:3001
PORT=3001

# Không bắt buộc. Để trống cả hai nếu không dùng CAPTCHA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Không bắt buộc. Khi chưa cấu hình, link mở khóa chỉ được in ở console backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
