PORT=3000
HOST=127.0.0.1
SPA_ORIGIN=http://localhost:5173
# auto: use Supabase if a key is set; otherwise start the local demo.
# supabase: require credentials. demo: always use isolated sample data.
DATABASE_DRIVER=auto

# Backend-only Supabase configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative to the legacy service-role JWT; keep backend-only.
SUPABASE_SECRET_KEY=
SUPABASE_SCHEMA=public
SUPABASE_DISHES_TABLE=dishes
SUPABASE_CHEFS_TABLE=chefs
SUPABASE_INGREDIENTS_TABLE=ingredients

# Only used when DATABASE_DRIVER=sqlite (local tests/offline development).
DATABASE_PATH=./data/restaurant.sqlite
DEMO_DATABASE_PATH=./data/demo.sqlite

# Only read/network errors may switch to isolated demo; mutations are never replayed.
DEMO_FALLBACK_ENABLED=true
# Optional migration/import credentials (never use VITE_* for these).
DATABASE_URL=
# Alternative connection URI. Use Session pooler when direct IPv6 is unreachable.
SUPABASE_DATABASE_URL=
# Download the project CA certificate from Supabase Database Settings.
PG_CA_CERT=./certs/supabase-ca.crt
# Optional: existing public bucket + local licensed images, not created automatically.
KAGGLE_IMAGES_DIR=
SUPABASE_KAGGLE_BUCKET=
# Optional upload concurrency: 1..32; default 6. Transient errors use bounded retry.
IMAGE_UPLOAD_CONCURRENCY=6


# CSR authentication (separate from Supabase catalog)
ACCESS_TOKEN_TTL_SECONDS=15
AUTH_DATABASE_PATH=./data/auth.sqlite
# Optional in local mode: an empty key generates a persistent private key next to auth.sqlite.
# Production: configure at least 32 random bytes here.
JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# file: local classroom mailbox, use npm run auth:mail -w api
# smtp: deliver real emails; configure the following SMTP settings.
MAIL_MODE=file
MAIL_OUTBOX_DIR=./data/mail-outbox
MAIL_FROM="Bep Nha <no-reply@bepnha.local>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# auto: PostgreSQL when a database connection URL is configured; otherwise SQLite.
AUTH_DATABASE_DRIVER=auto
