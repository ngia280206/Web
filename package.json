{
  "name": "bep-nha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "api",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w api",
    "test:e2e": "playwright test",
    "start:api": "npm run start -w api",
    "start:web": "npm run start -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.1"
  },
  "msw": {
    "workerDirectory": [
      "web\\public"
    ]
  }
}